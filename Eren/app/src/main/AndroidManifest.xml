<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- REQUIRED: copy this line into the target mod APK AndroidManifest -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Eren"
        android:usesCleartextTraffic="true">

        <!-- Hook entry: after smali edit this becomes the only launcher -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Eren.Transparent">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Main dialog activity -->
        <activity
            android:name=".Eren"
            android:exported="false"
            android:theme="@style/Theme.Eren.Dialog"
            android:excludeFromRecents="true"
            android:launchMode="singleTask" />

    </application>
</manifest>
